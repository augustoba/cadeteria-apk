<?xml version="1.0" encoding="utf-8"?>
<!--
  Permite tráfico http (no solo https) porque el backend puede correr en la LAN
  del local sin certificado (ver diseno-tecnico.md sección 7: sin requisitos de
  protección de datos definidos todavía). Si en algún momento el backend queda
  detrás de HTTPS, se puede sacar este archivo y la referencia en el Manifest.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
